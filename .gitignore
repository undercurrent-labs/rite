# Rust
/target
**/*.rs.bk
# Keep Cargo.lock for reproducible CLI/tooling builds (binary workspace)
# (do not ignore)

# Local / generated
/.rite
# Generated reference. Most of what `rite docs build` writes is scaffolding,
# but these two are real, complete and published on the site, so they are
# tracked and CI checks they are current.
/docs/generated/*
!/docs/generated/capabilities.md
!/docs/generated/cli.md
/dist

# JS / package managers
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
**/dist/
apps/*/dist/
editors/vscode/*.vsix
editors/vscode/out/
*.tsbuildinfo

# WASM build products (regenerate: bash scripts/build-wasm.sh)
apps/*/public/wasm/
apps/*/dist/wasm/

# Cloudflare / Wrangler (may contain account ids)
.wrangler/
**/.wrangler/
**/.cache/wrangler/
**/wrangler-account.json

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.p12
id_rsa*
credentials.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Test / coverage
coverage/
*.lcov
.nyc_output/

# Misc
*.log
tmp/
.temp/

# Private / internal specs (not published)
/mvp.md
/v1.md

# Packaging test outputs
/target/packaging-test/
/dist/skill-check/
/dist/vscode/
*.vsix

# Working notes: roadmaps, naming, half-formed plans. Deliberately not published —
# IMPLEMENTATION.md is the public status page.
/.internal/
