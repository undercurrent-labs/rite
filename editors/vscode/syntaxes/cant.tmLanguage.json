{
  "name": "Cant",
  "scopeName": "source.cant",
  "_comment": "Spellings come from grammar/cant/operators.toml. crates/rite-cli/tests/editor_grammar_sync.rs fails if the two disagree, in either direction. Order matters: comments and strings first, so an arrow inside one is not an arrow.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#capabilities" },
    { "include": "#numbers" },
    { "include": "#modifiers" },
    { "include": "#structure" },
    { "include": "#operators" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cant",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cant",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.cant",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.cant",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.cant", "match": "\\\\." }
          ]
        }
      ]
    },
    "capabilities": {
      "_comment": "`!@fs.read` reads as one thing. The bang is an operator, `@fs` the namespace, `read` the function — matching how cant-render classifies it.",
      "patterns": [
        {
          "match": "(!)?(@[A-Za-z_][A-Za-z0-9_]*)(?:(\\.)([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.operator.effect.cant" },
            "2": { "name": "support.class.capability.cant" },
            "3": { "name": "punctuation.accessor.cant" },
            "4": { "name": "support.function.capability.cant" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.cant", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
        { "name": "constant.numeric.integer.cant", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "modifiers": {
      "_comment": "`:by`/`:max` after a block, and Rite's atom prefix everywhere else. Both read as a named thing, which is what the palette gives `atom`.",
      "patterns": [
        { "name": "constant.other.atom.cant", "match": ":[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "structure": {
      "_comment": "The block openers, longest first: `?{` before `?`, and the two-character glyphs before their first character.",
      "patterns": [
        { "name": "keyword.control.ward.cant", "match": "\\?\\{|⊣⟦" },
        { "name": "keyword.control.fork.cant", "match": "\\|\\{|⫴⟦" },
        { "name": "keyword.control.orbit.cant", "match": "~\\{|⟲⟦" },
        { "name": "keyword.control.block-close.cant", "match": "\\}|⟧" },
        { "name": "keyword.control.collect.cant", "match": "\\[\\]|⌁" },
        { "name": "punctuation.separator.branch.cant", "match": ";" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.flow.cant", "match": "->|→" },
        { "name": "keyword.operator.scatter.cant", "match": "⋇" },
        { "name": "variable.language.current.cant", "match": "\\$" },
        { "name": "keyword.operator.effect.cant", "match": "!(?!=)" },
        { "name": "keyword.operator.cant", "match": "\\*|\\+|-|/|%|==|!=|<=|>=|<|>|=|\\?\\?" }
      ]
    },
    "keywords": {
      "_comment": "`use` is the only word Cant reserves; everything else in a stage is Rite expression text.",
      "patterns": [
        { "name": "keyword.control.import.cant", "match": "\\buse\\b" },
        { "name": "constant.language.cant", "match": "\\b(true|false|none|ok|err)\\b" }
      ]
    }
  }
}
