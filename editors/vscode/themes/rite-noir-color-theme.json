  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8b9bb4", "fontStyle": "italic" }
    },
    {
      "name": "Rite — doc comment. Lifted off the ordinary comment colour because in Rite a `///` line is API surface, not an aside.",
      "scope": ["comment.line.documentation.rite"],
      "settings": { "foreground": "#a8b6c8", "fontStyle": "italic" }
    },

    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted.double.rite",
        "string.quoted.raw.rite",
        "meta.embedded.assembly"
      ],
      "settings": { "foreground": "#c3e88d" }
    },
    {
      "name": "String punctuation",
      "scope": ["punctuation.definition.string"],
      "settings": { "foreground": "#8fae66" }
    },
    {
      "name": "Escape / interpolation — must read as an escape from the string, so it takes the operator blue.",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.rite",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#89ddff" }
    },
    {
      "name": "Rite — interpolated expression returns to plain text",
      "scope": ["meta.interpolation.rite"],
      "settings": { "foreground": "#e2e8f0" }
    },

    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.numeric.rite",
        "constant.language",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#f78c6c" }
    },
    {
      "name": "Rite — atom. Same pink as the sigils: an atom is a literal name, the closest thing the value world has to a mark.",
      "scope": ["constant.other.atom.rite", "constant.other.symbol", "constant.other.key"],
      "settings": { "foreground": "#ff7edb" }
    },

    {
      "name": "Rite — capability module (@fs, @http)",
      "scope": ["support.module.capability.rite"],
      "settings": { "foreground": "#7ee0ff" }
    },
    {
      "name": "Rite — capability function (.read, .listen)",
      "scope": ["support.function.capability.rite"],
      "settings": { "foreground": "#a9e9ff" }
    },
    {
      "name": "Rite — HTTP verbs",
      "scope": ["keyword.other.http.rite"],
      "settings": { "foreground": "#ffcb6b", "fontStyle": "bold" }
    },
    {
      "name": "Rite — sigils. ◆ ← → ⟦ ⟧ and their ASCII twins lex to the same tokens, so `def` and `◆` colour alike; that is the point of the two dialects being one language.",
      "scope": ["keyword.operator.glyph.rite"],
      "settings": { "foreground": "#ff7edb", "fontStyle": "bold" }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.rite",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#c792ea" }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.rite",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#89ddff" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#8b9bb4" }
    },

    {
      "name": "Variable / plain identifier",
      "scope": ["variable", "meta.definition.variable.name", "support.variable", "source"],
      "settings": { "foreground": "#e2e8f0" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.function.parameter"],
      "settings": { "foreground": "#d6c4e8" }
    },
    {
      "name": "Property / member",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#a9e9ff" }
    },
    {
      "name": "Language variable (this, self)",
      "scope": ["variable.language"],
      "settings": { "foreground": "#ff7edb", "fontStyle": "italic" }
    },

    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic"
      ],
      "settings": { "foreground": "#7ee0ff" }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#ffcb6b" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#ff7edb" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c3e88d", "fontStyle": "italic" }
    },
    {
      "name": "Decorator / annotation",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#c792ea", "fontStyle": "italic" }
    },

    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff5f6e" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#ffcb6b", "fontStyle": "strikethrough" }
    },

    {
      "name": "Markdown — heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#7ee0ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown — inline code",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#c3e88d" }
    },
    {
      "name": "Markdown — link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#a9e9ff", "fontStyle": "underline" }
    },
    {
      "name": "Markdown — emphasis",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown — strong",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e6edf5", "fontStyle": "bold" }
    },
    {
      "name": "Markdown — quote / list marker",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#8b9bb4" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#c3e88d" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff5f6e" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffcb6b" }
    },

    {
      "name": "JSON / YAML key",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "support.type.property-name.toml"
      ],
      "settings": { "foreground": "#7ee0ff" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#ffcb6b" }
    },
    {
      "name": "Rust lifetime",
      "scope": ["storage.modifier.lifetime.rust", "entity.name.type.lifetime.rust"],
      "settings": { "foreground": "#f78c6c", "fontStyle": "italic" }
    },
    {
      "name": "Rust macro",
      "scope": ["entity.name.function.macro.rust", "support.function.macro"],
      "settings": { "foreground": "#ff7edb" }
    }
  ]
}
