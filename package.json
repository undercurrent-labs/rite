{
  "name": "rite-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "site:dev": "pnpm --dir apps/rite-web dev",
    "site:build": "bash scripts/build-site.sh",
    "site:deploy": "bash scripts/build-site.sh && (cd apps/rite-web && npx wrangler deploy)",
    "cant:dev": "pnpm --dir apps/cant-web dev",
    "cant:build": "bash scripts/build-cant-site.sh",
    "cant:wasm": "bash scripts/build-cant-wasm.sh",
    "cant:deploy": "bash scripts/build-cant-site.sh && (cd apps/cant-web && npx wrangler deploy)",
    "sigil:dev": "pnpm --dir apps/sigil-web dev",
    "sigil:build": "bash scripts/build-sigil-site.sh",
    "sigil:preview": "pnpm --dir apps/sigil-web preview",
    "sigil:wasm": "bash scripts/build-sigil-wasm.sh",
    "sigil:test": "cargo test -p rite-sigil -p cant-sigil-wasm --all-features && pnpm --dir apps/sigil-web typecheck",
    "sigil:deploy": "bash scripts/build-sigil-site.sh && (cd apps/sigil-web && npx wrangler deploy)",
    "release:package": "bash scripts/package-release.sh",
    "studio:dev": "pnpm --dir apps/rite-studio dev",
    "studio:build": "pnpm --dir apps/rite-studio build",
    "wasm:build": "bash scripts/build-wasm.sh",
    "studio:build:full": "bash scripts/build-wasm.sh && pnpm --dir apps/rite-studio build",
    "vscode:compile": "pnpm --dir editors/vscode exec tsc -p .",
    "docs:build": "cargo run -p rite-cli -- docs build",
    "docs:check": "cargo run -p rite-cli -- docs check",
    "test:packaging": "bash scripts/check-packaging.sh",
    "package:skill": "bash scripts/package-skill.sh dist/skill",
    "package:vsix": "bash scripts/package-vsix.sh dist/vscode/rite.vsix"
  }
}
