◆ size(n) ⟦
  ^ ~ n ⟦
    1 | 2 | 3 → "small"
    4 | 5 | 6 → "medium"
    _ → "large"
  ⟧
⟧

^ ⟨
  first_alt: size(1),
  last_alt: size(3),
  second_group: size(5),
  fallthrough: size(9),
  strings: ~ "b" ⟦
    "a" | "b" → "letter"
    _ → "other"
  ⟧,
  atoms_saturate: ~ true ⟦
    true | false → "bool"
  ⟧,
  binding_in_alternatives: ~ err("boom") ⟦
    ok v | err v → v
  ⟧
⟩
