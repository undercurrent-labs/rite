// A `map<string, int32>` is a record on the Rite side. Repeated fields are lists,
// which is the other half of the same mapping.
schema ← ! @proto.compile("syntax = \"proto3\";\npackage demo;\nenum Tier {{ FREE = 0; PRO = 1; }}\nmessage User {{\n  int64 id = 1;\n  string name = 2;\n  bytes token = 3;\n  Tier tier = 4;\n  repeated string tags = 5;\n  map<string, int32> counts = 6;\n  optional string nick = 7;\n  uint64 quota = 8;\n}}\n")?

body ← @proto.encode(schema, "demo.User", ⟨counts: ⟨a: 1, b: 2⟩, tags: ["x", "y"]⟩)?
back ← @proto.decode(schema, "demo.User", body)?

ok_map ← back.counts.a = 1 ∧ back.counts.b = 2
ok_list ← back.tags = ["x", "y"]

ok_map ∧ ok_list
