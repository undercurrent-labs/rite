//! Violet Gate — ASCII dialect variant of game.rite.
//! Generated with: rite convert game.rite --to ascii
//! Same program, same stdout — only the surface syntax differs.
do host.game.register_item(:glyph_key, <<name: "Violet Glyph Key", weight: 1>>)
do host.game.register_item(:sun_shard, <<name: "Sun Shard", weight: 1>>)

do host.game.register_room(:corridor, <<text: "A narrow corridor of fractured violet glass. Exits: east vault, west atrium, north archives.", exits: <<east: "vault", west: "atrium", north: "archives">>>>)

do host.game.register_room(:vault, <<text: "A sealed gate hums beneath fractured violet glass.", exits: <<west: "corridor">>>>)

do host.game.register_room(:atrium, <<text: "Rain of neon drips from a broken skylight. A pedestal holds a violet glyph key.", exits: <<east: "corridor", south: "garden">>>>)

do host.game.register_room(:archives, <<text: "Dusty data-scrolls line the shelves. One shelf is marked: SUN PROTOCOL.", exits: <<south: "corridor">>>>)

do host.game.register_room(:garden, <<text: "A rooftop garden of fiber-optic vines. The city grid glows below.", exits: <<north: "atrium">>>>)

do host.game.start(:atrium)
do host.game.take(:glyph_key)
do host.console.println(host.game.look())
do host.game.command("east")
do host.console.println(host.game.look())
do host.game.command("inventory")
msgs <- host.game.messages()
do host.console.println(msgs)
save <- host.game.save()?
do host.console.println("saved")
do host.game.load(save)?
do host.console.println("reloaded")
do host.console.println(host.game.state())
