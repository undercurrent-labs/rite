//! Tiny CLI tool: reads its own arguments.
//!
//! Run: rite run examples/06-cli-tool/main.rite -- alpha beta gamma
//! With no arguments it falls back to a sample list, so the example still runs bare.
//!
//! `@process.args` needs no `--allow` flag — the arguments are the invoker's own
//! input to this program. Spawning a *new* process (`@process.run`) does need one.

argv ← ! @process.args

args ← ? (argv → count) > 0 ⟦ argv ⟧ : ⟦ ["alpha", "beta", "gamma"] ⟧

! @console.println("count: " + str(args → count))
! @console.println(args → join(", "))
