//! Sinatra-style HTTP with built-in + custom auth middleware

@http.listen "127.0.0.1:0" ⟦
  use @http.log
  use @http.recover

  // Bearer token gate — short-circuit with 401, or call next(req)
  use { |req, next|
    token ← req.headers.authorization ?? ""
    ? token = "Bearer secret" ⟦
      next(req)
    ⟧ else ⟦
      ^ 401 ⟨error: #unauthorized⟩
    ⟧
  }

  GET "/health" ⟦
    ^ 200 ⟨status: #ok⟩
  ⟧

  GET "/secret" ⟦
    ^ 200 ⟨ok: true, message: "you are in"⟩
  ⟧

  GET "/echo/:word" |req| ⟦
    ^ 200 ⟨echo: req.path.word, query: req.query⟩
  ⟧
⟧
